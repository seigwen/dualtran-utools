{
  "$schema": "https://www.u-tools.cn/schema/plugin.json",
  "pluginName": "DualTran",
  "description": "翻译选中文本 / Translate selected text — Google 或自有 AI 模型（BYOK，20+ providers）",
  "author": "seigwen",
  "homepage": "https://github.com/seigwen/dualtran-utools",
  "version": "0.1.4",
  "logo": "assets/logo.png",
  "main": "index.app.html",
  "features": [
    {
      "code": "dt-translate",
      "explain": "翻译选中或输入的文本 (Google / AI BYOK)",
      "cmds": [
        "tr",
        "翻译",
        "dt",
        {
          "type": "over",
          "label": "翻译",
          "minLength": 1,
          "maxLength": 10000
        }
      ]
    }
  ],
  "preload": "preload.js"
}